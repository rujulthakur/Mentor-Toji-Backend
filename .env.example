# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Must match the frontend's dev/prod origin exactly (used for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gymtracker?retryWrites=true&w=majority
MONGODB_URI=

# --- Redis (OTP storage + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Google Sign-In ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (type: "Web application"). Only the Client ID is needed here — the ID
# token Google issues to the frontend is verified against Google's public
# keys, so no client secret ever touches this backend.
# Add your frontend's origin (e.g. http://localhost:5173) to both
# "Authorized JavaScript origins" in that same OAuth client.
GOOGLE_CLIENT_ID=

# --- JWT ---
# Generate strong secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (nodemailer — used to send the OTP template) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="GymTracker AI" <noreply@gymtracker.ai>

# --- Cloudinary (progress photos / avatars) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Grok (xAI) — AI Coach. Called server-side only; the key never reaches the browser. ---
GROK_API_KEY=
GROK_API_URL=https://api.groq.com/openai/v1/chat/completions
GROK_MODEL=llama-3.3-70b-versatile

# --- OTP behavior ---
OTP_TTL_SECONDS=300
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
